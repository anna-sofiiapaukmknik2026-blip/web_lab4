@model Ingredient
@{
    ViewData["Title"] = "Видалення інгредієнта";
}

<div class="page-header">
    <h1>Видалити інгредієнт?</h1>
</div>

<div class="card border-danger">
    <div class="card-body">
        <p class="mb-3">Ви збираєтеся видалити інгредієнт <strong>@Model.Name</strong>.</p>
        @if (Model.DishIngredients.Any())
        {
            <div class="alert alert-warning">
                Інгредієнт входить до складу @Model.DishIngredients.Count страв:
                @(string.Join(", ", Model.DishIngredients.Select(di => di.Dish!.Name))).
                Після видалення його буде прибрано зі складу цих страв.
            </div>
        }
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Так, видалити</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Скасувати</a>
        </form>
    </div>
</div>