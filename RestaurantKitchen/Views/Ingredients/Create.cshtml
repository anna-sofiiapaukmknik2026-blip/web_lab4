@model Ingredient
@{
    ViewData["Title"] = "Новий інгредієнт";
}

<div class="page-header">
    <h1>Новий інгредієнт</h1>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_IngredientForm" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-kitchen"><i class="bi bi-check-lg"></i> Зберегти</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}