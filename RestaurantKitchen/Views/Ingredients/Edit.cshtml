@model Ingredient
@{
    ViewData["Title"] = "Редагування інгредієнта";
}

<div class="page-header">
    <h1>Редагування: @Model.Name</h1>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_IngredientForm" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-kitchen"><i class="bi bi-check-lg"></i> Зберегти зміни</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}